---
import SiteLayout from '../layouts/SiteLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { dance } from '../data/somatic-dance';
import { site } from '../data/site';
const navigation = [
  { label: 'Home', href: '/' },
  { label: 'The practice', href: '#practice' },
  { label: 'What to expect', href: '#experience' },
  { label: 'Session details', href: '#sessions' },
];
---
<SiteLayout title={`${dance.title} | ${site.name}`} description="Somatic Dance with GG Empowers. Explore the practice, session information, and ways to get in touch." navigation={navigation} contactHref="#contact">
  <main id="main">
    <section class="hero wrap dance-hero" aria-labelledby="dance-title">
      <div class="hero-copy">
        <p class="eyebrow">GG Empowers · {dance.title}</p>
        <h1 id="dance-title">{dance.headline}</h1>
        <p class="intro">{dance.introduction}</p>
        <div class="actions"><a class="button" href={dance.booking.href}>{dance.booking.label}</a><a class="text-link" href="#experience">Explore the experience</a></div>
      </div>
      <figure class="hero-visual"><img src={dance.image.src} alt={dance.image.alt} width="1200" height="800" fetchpriority="high" /></figure>
    </section>
    <section id="practice" class="testimonials section-space" aria-labelledby="practice-title">
      <div class="wrap narrow"><p class="eyebrow">The practice</p><h2 id="practice-title">Movement with room for you.</h2><p>{dance.about}</p></div>
    </section>
    <section id="experience" class="wrap section-space" aria-labelledby="experience-title">
      <div class="section-heading"><p class="eyebrow">What to expect</p><h2 id="experience-title">A moment to connect with yourself.</h2></div>
      <div class="offering-grid">{dance.experience.map((step) => <article class="offering-card"><h3>{step.title}</h3><p>{step.body}</p></article>)}</div>
    </section>
    <section id="sessions" class="offerings section-space" aria-labelledby="sessions-title">
      <div class="wrap"><div class="section-heading"><p class="eyebrow">Session details</p><h2 id="sessions-title">Make space in your day.</h2><p>[Add confirmed session information before inviting bookings.]</p></div>
        <dl class="dance-details">{dance.details.map((detail) => <div><dt>{detail.label}</dt><dd>{detail.value}</dd></div>)}</dl>
        <p class="gallery-link"><a class="button" href={dance.booking.href}>{dance.booking.label}</a></p>
      </div>
    </section>
    <section class="wrap section-space dance-faq" aria-labelledby="faq-title">
      <p class="eyebrow">Your questions</p><h2 id="faq-title">Before you join.</h2>
      {dance.faqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}
    </section>
    <section id="contact" class="contact section-space" aria-labelledby="contact-title">
      <div class="wrap contact-inner"><div><p class="eyebrow">Somatic Dance · GG Empowers</p><h2 id="contact-title">Let’s start with a conversation.</h2><p>[Add your invitation to ask questions or discuss a session.]</p></div><div class="contact-actions"><a class="button light" href={dance.booking.href}>{dance.booking.label}</a><SocialLinks /></div></div>
    </section>
  </main>
</SiteLayout>
