---
import { site } from '../data/site';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  navigation?: { label: string; href: string }[];
  contactHref?: string;
}
const {
  title = site.name,
  description = site.description,
  navigation = [
    { label: 'About', href: '#about' },
    { label: 'Offerings', href: '#offerings' },
    { label: 'Somatic Dance', href: '/somatic-dance/' },
    { label: 'Experiences', href: '#experiences' },
    { label: 'Kind words', href: '#testimonials' },
  ],
  contactHref = site.secondaryCta.href,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#30271e" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="draft-note">Design draft · Bracketed text and image spaces are placeholders.</div>
    <header class="site-header wrap">
      <a class="brand-logo" href="/" aria-label="GG Empowers home"><img src={site.logo.src} alt={site.logo.alt} width="600" height="400" /></a>
      <nav aria-label="Main navigation">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="button small" href={contactHref}>{site.secondaryCta.label}</a>
      </nav>
    </header>
    <slot />
    <footer class="wrap site-footer"><a class="brand-logo" href="/" aria-label="GG Empowers home"><img src={site.logo.src} alt={site.logo.alt} width="600" height="400" loading="lazy" /></a><p>© {new Date().getFullYear()} GG Empowers</p><a href="#main">Back to top</a></footer>
  </body>
</html>
