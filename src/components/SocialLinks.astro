---
import { site } from '../data/site';
---
<nav class="social-links" aria-label="Social links">
  {site.socials.map((social) => (
    <a href={social.href} class="social-link">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        {social.label === 'Instagram' && <>
          <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8" />
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
        </>}
        {social.label === 'Facebook' && <path d="M14 21v-8h3l.5-4H14V7c0-1.2.4-2 2-2h2V1.5c-.8-.1-1.8-.2-3-.2-3 0-5 1.8-5 5.2V9H7v4h3v8z" fill="currentColor" />}
        {social.label === 'YouTube' && <>
          <rect x="2" y="5" width="20" height="14" rx="4" stroke="currentColor" stroke-width="1.8" />
          <path d="m10 8 6 4-6 4z" fill="currentColor" />
        </>}
      </svg>
      <span>{social.label}</span>
    </a>
  ))}
</nav>
